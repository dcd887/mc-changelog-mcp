{
  "name": "mc-changelog-mcp",
  "version": "1.0.0",
  "description": "MCP server for Minecraft modpack changelog generation. Compare modpack versions, generate structured change logs.",
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "mc-changelog-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('src/changelog-templates.json','dist/changelog-templates.json')\"",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "node test.js",
    "test:unit": "node --test --test-force-exit __tests__/*.test.ts",
    "test:all": "npm run test:unit && npm test"
  },
  "keywords": [
    "minecraft",
    "modpack",
    "mcp",
    "model-context-protocol",
    "changelog",
    "fabric",
    "forge"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.0.0"
  }
}
