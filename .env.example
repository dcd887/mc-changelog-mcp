# mc-changelog-mcp 配置示例 — 复制为 .env 并按需填写（不填则用内置默认值）

# Modrinth API 根地址（支持自建网关/代理）
# MODRINTH_API_BASE=https://api.modrinth.com/v2

# 请求 User-Agent（Modrinth 要求标明来源）
# CHANGELOG_USER_AGENT=mc-changelog-mcp/1.0

# 整合包内模组所在的子目录名
# CHANGELOG_MODS_DIR=mods

# 增强信息（enrich）时每个模组返回的版本数量上限
# CHANGELOG_ENRICH_LIMIT=5
